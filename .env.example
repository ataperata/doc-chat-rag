# Supabase project URL. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key. Safe in the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Model API key. Folio sends this to the Vercel AI Gateway as AI_GATEWAY_API_KEY.
# On Vercel, a project OIDC token (VERCEL_OIDC_TOKEN) can stand in for this key.
AI_GATEWAY_API_KEY=

# Optional. Embedding dimensions must stay 1536 to match supabase/migrations.
AI_CHAT_MODEL=openai/gpt-5.4-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# demo, live, or empty. Empty uses live only when Supabase and a model credential are both set.
FOLIO_DATA_MODE=
